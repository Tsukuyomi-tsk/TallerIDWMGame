# =============================================================================
# GameVault UCN — variables de entorno
# Copiar este archivo a .env y completar los valores. NUNCA commitear .env
# con credenciales reales (ya esta en .gitignore).
# =============================================================================

# --- Aplicacion --------------------------------------------------------------
APP_NAME=GameVault UCN
# development | production. En production la app NO arranca si faltan
# credenciales de Resend o Cloudinary (ver README, seccion "Modo desarrollo").
ENVIRONMENT=development
DEBUG=true
# Origenes permitidos para CORS, separados por coma. "*" solo en development.
CORS_ORIGINS=*

# --- Base de datos -------------------------------------------------------
# SQLite por defecto. No cambiar el driver sin ajustar core/database.py.
DATABASE_URL=sqlite:///./gamevault.db

# --- Seguridad / JWT -----------------------------------------------------
# Clave para firmar los JWT. Generar una propia, nunca usar este valor en
# produccion, ej: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-your-own-env-file
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting (endpoints de /auth) -----------------------------------
RATE_LIMIT_AUTH=5/minute

# --- Verificacion de correo (registro) -------------------------------------
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_BLOCK_MINUTES=30
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- Jobs programados (APScheduler) -----------------------------------------
SCHEDULER_ENABLED=true
UNVERIFIED_ACCOUNT_TTL_HOURS=48
BLACKLIST_PURGE_INTERVAL_HOURS=6
GUEST_CART_TTL_DAYS=30

# --- Seeder ------------------------------------------------------------------
# Se ejecuta automaticamente al arrancar si SEED_ON_STARTUP=true. Tambien se
# puede correr a mano con: python -m app.seeders.run
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@gamevault.ucn.cl
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Administrador GameVault

# --- Resend (correos transaccionales) ---------------------------------------
# Si se deja vacio, el sistema cae automaticamente a modo desarrollo: los
# correos se escriben en ./outbox/ en vez de enviarse. Ver README.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GameVault UCN <no-reply@gamevault.ucn.cl>

# --- Cloudinary (imagenes del catalogo) -------------------------------------
# Si falta cualquiera de las tres, el sistema cae a modo desarrollo: las
# imagenes se guardan en ./media/ en vez de subirse a Cloudinary. Ver README.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
